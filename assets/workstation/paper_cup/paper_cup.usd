#usda 1.0
(
    defaultPrim = "PaperCup"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PaperCup" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string robot_agent_lab_json = '{"frame": "bottom centre", "collision": "compound: base cylinder + 16 tilted wall boxes (open top, hollow)", "deformation": "not modelled"}'
    }
    kind = "component"
)
{
    point3f physics:centerOfMass = (3.5707427e-18, -4.0869675e-18, 0.05338072)
    float3 physics:diagonalInertia = (0.000022054253, 0.000022054253, 0.00001260773)
    float physics:mass = 0.012
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Xform "Visual" (
        prepend references = @./paper_cup_visual.usd@
    )
    {
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
        customData = {
            dictionary robot_agent_lab = {
                string material_id = "paper"
            }
        }
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0.05
        float physics:staticFriction = 0.6
    }

