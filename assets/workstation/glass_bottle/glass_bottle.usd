#usda 1.0
(
    defaultPrim = "GlassBottle"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "GlassBottle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string robot_agent_lab_json = '{"frame": "bottom centre", "collision": "compound: body cylinder + shoulder convex hull + neck cylinder (solid, not hollow)"}'
    }
    kind = "component"
)
{
    point3f physics:centerOfMass = (8.039703e-19, -4.032983e-18, 0.088230796)
    float3 physics:diagonalInertia = (0.0014238674, 0.0014238674, 0.0001898911)
    float physics:mass = 0.3
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Xform "Visual" (
        prepend references = @./glass_bottle_visual.usd@
    )
    {
    }

