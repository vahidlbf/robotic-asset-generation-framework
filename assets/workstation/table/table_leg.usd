#usda 1.0
(
    defaultPrim = "TableLeg"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "TableLeg" (
    customData = {
        string robot_agent_lab_json = '{"frame": "bottom centre", "size": [0.05, 0.05, 0.72]}'
    }
    kind = "component"
)
{
    def Xform "Visual" (
        prepend references = @./table_leg_visual.usd@
    )
    {
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
        customData = {
            dictionary robot_agent_lab = {
                string material_id = "table"
            }
        }
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0.05
        float physics:staticFriction = 0.6
    }

    def Scope "Collision"
    {
        def Xform "LegBox"
        {
            double3 xformOp:translate = (0, 0, 0.36)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Shape" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </TableLeg/PhysicsMaterial> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (0.05, 0.05, 0.72)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }
}

