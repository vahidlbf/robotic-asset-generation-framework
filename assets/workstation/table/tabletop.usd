#usda 1.0
(
    defaultPrim = "Tabletop"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Tabletop" (
    customData = {
        string robot_agent_lab_json = '{"frame": "geometric centre", "size": [1.6, 0.8, 0.03]}'
    }
    kind = "component"
)
{
    def Xform "Visual" (
        prepend references = @./tabletop_visual.usd@
    )
    {
    }

    def Material "PhysicsMaterial" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
        customData = {
            dictionary robot_agent_lab = {
                string material_id = "table"
            }
        }
    )
    {
        float physics:dynamicFriction = 0.5
        float physics:restitution = 0.05
        float physics:staticFriction = 0.6
    }

    def Scope "Collision"
    {
        def Xform "TopSlab"
        {
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Shape" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding:physics = </Tabletop/PhysicsMaterial> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                uniform token purpose = "guide"
                double size = 1
                float3 xformOp:scale = (1.6, 0.8, 0.03)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }
    }
}

