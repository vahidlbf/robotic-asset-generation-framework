#usda 1.0
(
    defaultPrim = "PlasticBottle"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "PlasticBottle" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string robot_agent_lab_json = '{"frame": "bottom centre", "deformation": "not modelled (rigid body)", "collision": "compound: body cylinder + shoulder convex hull + neck/ring cylinder + cap cylinder"}'
    }
    kind = "component"
)
{
    point3f physics:centerOfMass = (-3.3599398e-18, -1.2413679e-17, 0.097260654)
    float3 physics:diagonalInertia = (0.00014131627, 0.00014131627, 0.00001873464)
    float physics:mass = 0.025
    quatf physics:principalAxes = (1, 0, 0, 0)

    def Xform "Visual" (
        prepend references = @./plastic_bottle_visual.usd@
    )
    {
    }

