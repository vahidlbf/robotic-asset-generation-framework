    def Scope "Looks"
    {
        def Material "glass_bottle_OmniGlass"
        {
            token outputs:mdl:surface.connect = </World/Looks/glass_bottle_OmniGlass/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 0.003
                float inputs:frosting_roughness = 0.06
                color3f inputs:glass_color = (0.25, 0.5, 0.95)
                float inputs:glass_ior = 1.5
                bool inputs:thin_walled = 0
                token outputs:out
            }
        }

        def Material "plastic_bottle_OmniGlass"
        {
            token outputs:mdl:surface.connect = </World/Looks/plastic_bottle_OmniGlass/Shader.outputs:out>

            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniGlass.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniGlass"
                float inputs:depth = 0.0006
                float inputs:frosting_roughness = 0.03
                color3f inputs:glass_color = (0.82, 0.92, 0.98)
                float inputs:glass_ior = 1.57
                bool inputs:thin_walled = 1
                token outputs:out
            }
        }
    }

    def Xform "RobotMount" (
        kind = "group"
    )
    {
        quatd xformOp:orient = (0.7071067811865476, 0, 0, -0.7071067811865475)
        double3 xformOp:translate = (0.45, 0.15, 0.75)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

        def Xform "Robot" (
            prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.2/Isaac/Robots/FrankaRobotics/FrankaPanda/franka.usd@
            variants = {
                string Gripper = "Default"
                string Mesh = "Performance"
            }
        )
        {
            over "panda_link0" (
                prepend apiSchemas = ["PhysicsFilteredPairsAPI"]
            )
            {
                prepend rel physics:filteredPairs = </World/Workstation/Table/Tabletop/Collision/TopSlab/Shape>

                over "panda_joint1" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = 0
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_link1"
            {
                over "panda_joint2" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = -45
                    float state:angular:physics:position = -45
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_link2"
            {
                over "panda_joint3" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = 0
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_link3"
            {
                over "panda_joint4" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = -135
                    float state:angular:physics:position = -135
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_link4"
            {
                over "panda_joint5" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = 0
                    float state:angular:physics:position = 0
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_link5"
            {
                over "panda_joint6" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = 90
                    float state:angular:physics:position = 90
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_link6"
            {
                over "panda_joint7" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:angular"]
                )
                {
                    float drive:angular:physics:targetPosition = 45
                    float state:angular:physics:position = 45
                    float state:angular:physics:velocity = 0
                }
            }

            over "panda_hand"
            {
                over "panda_finger_joint1" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
                )
                {
                    float drive:linear:physics:targetPosition = 0.04
                    float state:linear:physics:position = 0.04
                    float state:linear:physics:velocity = 0
                }

                over "panda_finger_joint2" (
                    prepend apiSchemas = ["PhysicsJointStateAPI:linear"]
                )
                {
                    float state:linear:physics:position = 0.04
                    float state:linear:physics:velocity = 0
                }
            }
        }
    }

