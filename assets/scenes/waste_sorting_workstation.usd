#usda 1.0
(
    customLayerData = {
        dictionary robot_agent_lab = {
            string config = "../../config/waste_sorting_environment.json"
            string generator = "scripts/workstation/build_scene.py"
            string note = "Physics coefficients are illustrative simulation parameters."
            string rendering_mode = "realtime"
            string robot_asset = "https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.2/Isaac/Robots/FrankaRobotics/FrankaPanda/franka.usd"
            string scene = "waste_sorting_workstation"
        }
    }
    defaultPrim = "World"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World" (
    kind = "assembly"
)
{
    def PhysicsScene "PhysicsScene" (
        prepend apiSchemas = ["PhysxSceneAPI"]
    )
    {
        vector3f physics:gravityDirection = (0, 0, -1)
        float physics:gravityMagnitude = 9.81
        uniform token physxScene:broadphaseType = "MBP"
        bool physxScene:enableCCD = 0
        bool physxScene:enableGPUDynamics = 0
        uniform token physxScene:solverType = "TGS"
        uint physxScene:timeStepsPerSecond = 120
    }

    def Xform "Environment" (
        kind = "group"
    )
    {
        def Scope "Looks"
        {
            def Material "FloorVisual"
            {
                token outputs:surface.connect = </World/Environment/Looks/FloorVisual/Shader.outputs:surface>

                def Shader "Shader"
                {
                    uniform token info:id = "UsdPreviewSurface"
                    color3f inputs:diffuseColor = (0.42, 0.43, 0.45)
                    float inputs:metallic = 0
                    float inputs:roughness = 0.8
                    token outputs:surface
                }
            }

            def Material "FloorPhysics" (
                prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
            )
            {
                float physics:dynamicFriction = 0.5
                float physics:restitution = 0.05
                float physics:staticFriction = 0.6
                uniform token physxMaterial:frictionCombineMode = "average"
                uniform token physxMaterial:restitutionCombineMode = "average"
            }
        }

        def Xform "Ground"
        {
            double3 xformOp:translate = (0, 0, -0.01)
            uniform token[] xformOpOrder = ["xformOp:translate"]

            def Cube "Floor" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "MaterialBindingAPI"]
            )
            {
                rel material:binding = </World/Environment/Looks/FloorVisual>
                rel material:binding:physics = </World/Environment/Looks/FloorPhysics> (
                    bindMaterialAs = "weakerThanDescendants"
                )
                double size = 1
                float3 xformOp:scale = (5, 5, 0.02)
                uniform token[] xformOpOrder = ["xformOp:scale"]
            }
        }

        def Xform "Lights"
        {
            def DomeLight "Dome"
            {
                color3f inputs:color = (1, 1, 1)
                float inputs:intensity = 450
            }

            def RectLight "KeyLight"
            {
                float inputs:height = 1.2
                float inputs:intensity = 9000
                float inputs:width = 1.2
                matrix4d xformOp:transform = ( (0.7863183388224226, 0.6178215519319035, -0, 0), (-0.44515341889411936, 0.5665588967743338, 0.6934330898743775, 0), (0.4284179077471231, -0.5452591553145203, 0.7205210266656161, 0), (1.2, -1.4, 2.6, 1) )
                uniform token[] xformOpOrder = ["xformOp:transform"]
            }

            def RectLight "FillLight"
            {
                float inputs:height = 1.5
                float inputs:intensity = 4500
                float inputs:width = 1.5
                matrix4d xformOp:transform = ( (-0.6305926250944657, -0.7761140001162655, 0, 0), (0.48497036424083506, -0.3940384209456784, 0.7807288060695262, 0), (-0.6059345566846162, 0.49232182730625057, 0.6248700115810103, 0), (-1.6, 1.3, 2.4, 1) )
                uniform token[] xformOpOrder = ["xformOp:transform"]
            }
        }
    }

    def Xform "Workstation" (
        kind = "group"
    )
    {
        def Xform "Table" (
            prepend references = @./../workstation/table/table.usd@
        )
        {
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]

            over "Tabletop"
            {
                over "PhysicsMaterial" (
                    prepend apiSchemas = ["PhysxMaterialAPI"]
                )
                {
                    uniform token physxMaterial:frictionCombineMode = "average"
                    uniform token physxMaterial:restitutionCombineMode = "average"
                }
            }

            over "Leg_FL"
            {
                over "PhysicsMaterial" (
                    prepend apiSchemas = ["PhysxMaterialAPI"]
                )
                {
                    uniform token physxMaterial:frictionCombineMode = "average"
                    uniform token physxMaterial:restitutionCombineMode = "average"
                }
