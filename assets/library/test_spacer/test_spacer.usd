def Xform "TestSpacer" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    customData = {
        string robot_agent_lab_json = '{"frame": "bottom centre", "asset_id": "test_spacer", "category": "hardware/spacer", "nominal_size_m": [0.03, 0.03, 0.025], "collision": "ring_segments", "spec": "../../../config/assets/test_spacer.json"}'
